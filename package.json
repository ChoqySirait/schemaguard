{
  "name": "schemaguard",
  "version": "0.1.0",
  "description": "Perkakas baris perintah pendeteksi perubahan merusak pada migrasi basis data dan spesifikasi API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "schemaguard": "./dist/index.js"
  },
  "scripts": {
